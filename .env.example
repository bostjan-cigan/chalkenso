# Chalkenso configuration. Copy to .env.local and fill in.

NEXT_PUBLIC_APP_URL=http://localhost:3100

# Signing in, two-factor codes and "Forgot your password?" are limited per address. 1 doesn't count
# requests from this machine (the end-to-end tests). Never on a server people use.
# AUTH_LIMITS_SKIP_LOOPBACK=1

# PostgreSQL (docker compose up starts one on POSTGRES_PORT)
POSTGRES_DB=curriculum_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:change-me@localhost:5433/curriculum_ai?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:change-me@localhost:5433/curriculum_ai?schema=public"

# Signs sessions, invite tokens and local file URLs. Use a long random string.
SESSION_SECRET=

# Encrypts secrets kept in the database (organisations' Anthropic keys): 32 random bytes, base64
# (openssl rand -base64 32). Set it once and never change it; without it SESSION_SECRET is used.
SECRETS_KEY=

# Optional: the platform admin created by `prisma db seed` (sees every organisation).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI (Claude). Without a key, AI features are hidden. AI_MOCK=1 returns sample output (demos, tests).
ANTHROPIC_API_KEY=
AI_MOCK=
# Models: lesson revisions use claude-sonnet-5-5, the rest claude-opus-5-5. AI_MODEL overrides all,
# AI_MODEL_<TASK> one (REVISE, PLAN, CHECK, THEMES, REPORT, WORDING).
# AI_MODEL=claude-opus-5-5

# Optional: email, for "Forgot your password?" and emailed invites (an invite link can always be copied
# instead). Any SMTP server: SMTP_HOST and SMTP_PORT, with SMTP_USER and SMTP_PASSWORD when it needs
# them; or RESEND_API_KEY for Resend. With neither, emails are written to the server log
# (`docker compose logs`). MAIL_FROM is the sender. In development, `yarn mail:up` starts Mailpit
# (SMTP_HOST=localhost, SMTP_PORT=1025, inbox on http://localhost:8025); SMTP wins over a Resend key.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# MAIL_FROM="Chalkenso <hello@example.com>"

# Optional: Cloudflare R2 for images. Without it, uploads are stored on disk in STORAGE_DIR.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# STORAGE_DIR=.data/media
